{
  "name": "radia-plugin",
  "version": "2.17.10",
  "description": "Rad IA - AI Assistant for Delphi IDE",
  "main": "eslint.config.js",
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test:semantic-corpus:12": "node scripts/Test-RadIA.SemanticCorpus.js --delphi-version 23.0",
    "test:semantic-corpus:13": "node scripts/Test-RadIA.SemanticCorpus.js --delphi-version 37.0",
    "test:semantic-completion:12": "node scripts/Test-RadIA.SemanticCompletionCorpus.js --delphi-version 23.0",
    "test:semantic-completion:13": "node scripts/Test-RadIA.SemanticCompletionCorpus.js --delphi-version 37.0",
    "test:semantic-members:12": "node scripts/Test-RadIA.SemanticMissingMembers.js --delphi-version 23.0",
    "test:semantic-members:13": "node scripts/Test-RadIA.SemanticMissingMembers.js --delphi-version 37.0",
    "test:closure-ledger": "node --test --test-isolation=none Tests/Web/RadIA.CompetitiveClosureLedger.test.js",
    "test:web": "node --test --test-isolation=none Tests/Web/*.test.js",
    "test:docs": "node --test --test-isolation=none Tests/Web/RadIA.Documentation.test.js"
  },
  "devDependencies": {
    "eslint": "^9.0.0"
  },
  "private": true
}
