{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://radia.local/schemas/memory-diagnostic-evidence-v1.json",
  "title": "RadIA memory diagnostic evidence",
  "type": "object",
  "required": [
    "schemaVersion",
    "evidenceId",
    "capturedAtUtc",
    "session",
    "termination",
    "groups",
    "snapshots",
    "fingerprint"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "evidenceId": {
      "type": "string",
      "pattern": "^[a-f0-9]{32}$"
    },
    "capturedAtUtc": {
      "type": "string",
      "format": "date-time"
    },
    "session": {
      "$ref": "#/$defs/session"
    },
    "termination": {
      "enum": [
        "unknown",
        "controlled",
        "exceptional",
        "cancelled",
        "timedOut"
      ]
    },
    "groups": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "$ref": "#/$defs/allocationGroup"
      }
    },
    "snapshots": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "$ref": "#/$defs/snapshot"
      }
    },
    "fingerprint": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "limits": {
      "type": "object",
      "required": [
        "maxDurationMs",
        "maxLogBytes",
        "maxRepetitions"
      ],
      "properties": {
        "maxDurationMs": {
          "type": "integer",
          "minimum": 1000,
          "maximum": 1800000
        },
        "maxLogBytes": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 1073741824
        },
        "maxRepetitions": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50
        }
      },
      "additionalProperties": false
    },
    "session": {
      "type": "object",
      "required": [
        "sessionId",
        "projectPath",
        "executablePath",
        "buildId",
        "targetPlatform",
        "backend",
        "backendVersion",
        "processId",
        "scenarioFingerprint",
        "limits"
      ],
      "properties": {
        "sessionId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "projectPath": {
          "type": "string",
          "minLength": 1
        },
        "executablePath": {
          "type": "string",
          "minLength": 1
        },
        "buildId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "targetPlatform": {
          "enum": [
            "Win32",
            "Win64"
          ]
        },
        "backend": {
          "const": "fastmm5"
        },
        "backendVersion": {
          "type": "string",
          "pattern": "^5\\.[0-9]{2}$"
        },
        "processId": {
          "type": "integer",
          "minimum": 1
        },
        "scenarioFingerprint": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "limits": {
          "$ref": "#/$defs/limits"
        }
      },
      "additionalProperties": false
    },
    "stackFrame": {
      "type": "object",
      "required": [
        "addressId",
        "moduleName",
        "routineName",
        "fileName",
        "lineNumber"
      ],
      "properties": {
        "addressId": {
          "type": "string",
          "pattern": "^[a-f0-9]{16,64}$"
        },
        "moduleName": {
          "type": "string",
          "maxLength": 260
        },
        "routineName": {
          "type": "string",
          "maxLength": 1024
        },
        "fileName": {
          "type": "string",
          "maxLength": 1024
        },
        "lineNumber": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "allocationGroup": {
      "type": "object",
      "required": [
        "kind",
        "className",
        "blockSize",
        "allocationCount",
        "totalBytes",
        "allocationNumber",
        "fingerprint",
        "frames"
      ],
      "properties": {
        "kind": {
          "enum": [
            "leak",
            "doubleFree",
            "useAfterFree",
            "headerCorruption",
            "footerCorruption",
            "snapshotGrowth"
          ]
        },
        "className": {
          "type": "string",
          "maxLength": 512
        },
        "blockSize": {
          "type": "integer",
          "minimum": 1
        },
        "allocationCount": {
          "type": "integer",
          "minimum": 1
        },
        "totalBytes": {
          "type": "integer",
          "minimum": 1
        },
        "allocationNumber": {
          "type": "integer",
          "minimum": 0
        },
        "fingerprint": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "frames": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "$ref": "#/$defs/stackFrame"
          }
        }
      },
      "additionalProperties": false
    },
    "snapshot": {
      "type": "object",
      "required": [
        "label",
        "capturedAtUtc",
        "allocatedBytes",
        "committedBytes",
        "liveBlocks"
      ],
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "capturedAtUtc": {
          "type": "string",
          "format": "date-time"
        },
        "allocatedBytes": {
          "type": "integer",
          "minimum": 0
        },
        "committedBytes": {
          "type": "integer",
          "minimum": 0
        },
        "liveBlocks": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    }
  }
}
