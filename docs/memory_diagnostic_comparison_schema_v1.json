{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://radia.local/schemas/memory-diagnostic-comparison-v1.json",
  "title": "RadIA memory diagnostic comparison",
  "type": "object",
  "required": [
    "schemaVersion",
    "failureEvidenceId",
    "verificationEvidenceId",
    "comparable",
    "outcome",
    "failureBytes",
    "verificationBytes",
    "removedFingerprints",
    "remainingFingerprints",
    "newFingerprints"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "failureEvidenceId": {
      "type": "string",
      "pattern": "^[a-f0-9]{32}$"
    },
    "verificationEvidenceId": {
      "type": "string",
      "pattern": "^[a-f0-9]{32}$"
    },
    "comparable": {
      "type": "boolean"
    },
    "outcome": {
      "enum": [
        "incomparable",
        "fixed",
        "improved",
        "unchanged",
        "regressed"
      ]
    },
    "failureBytes": {
      "type": "integer",
      "minimum": 0
    },
    "verificationBytes": {
      "type": "integer",
      "minimum": 0
    },
    "removedFingerprints": {
      "$ref": "#/$defs/fingerprints"
    },
    "remainingFingerprints": {
      "$ref": "#/$defs/fingerprints"
    },
    "newFingerprints": {
      "$ref": "#/$defs/fingerprints"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "fingerprints": {
      "type": "array",
      "maxItems": 1000,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      }
    }
  }
}
