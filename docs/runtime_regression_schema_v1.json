{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://radia.local/schemas/runtime-regression-v1.json",
  "title": "RadIA runtime regression",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "savedAtUtc",
    "fingerprint",
    "scenario"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]{3,64}$"
    },
    "savedAtUtc": {
      "type": "string",
      "format": "date-time"
    },
    "fingerprint": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "scenario": {
      "$ref": "#/$defs/scenario"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "scenario": {
      "type": "object",
      "required": [
        "name",
        "limits",
        "actions"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "limits": {
          "$ref": "#/$defs/limits"
        },
        "actions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": {
            "$ref": "#/$defs/action"
          }
        }
      },
      "additionalProperties": false
    },
    "limits": {
      "type": "object",
      "required": [
        "maxActions",
        "maxDurationMs",
        "maxRepetitions"
      ],
      "properties": {
        "maxActions": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "maxDurationMs": {
          "type": "integer",
          "minimum": 100,
          "maximum": 300000
        },
        "maxRepetitions": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        }
      },
      "additionalProperties": false
    },
    "action": {
      "type": "object",
      "required": [
        "kind",
        "timeoutMs"
      ],
      "properties": {
        "kind": {
          "enum": [
            "invoke",
            "setValue",
            "select",
            "close",
            "cancel",
            "wait",
            "assert"
          ]
        },
        "selector": {
          "$ref": "#/$defs/selector"
        },
        "value": {
          "type": "string",
          "maxLength": 4096
        },
        "timeoutMs": {
          "type": "integer",
          "minimum": 100,
          "maximum": 300000
        }
      },
      "additionalProperties": false
    },
    "selector": {
      "type": "object",
      "required": [
        "className",
        "text",
        "parentPath"
      ],
      "properties": {
        "className": {
          "type": "string",
          "minLength": 1
        },
        "controlName": {
          "type": "string"
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "parentPath": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    }
  }
}
