<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <ProjectGuid>{D8DCE8C4-FA50-46C7-8F29-D687ED804DF8}</ProjectGuid>
    <MainSource>RadIARuntimeLab.dpr</MainSource>
    <ProjectVersion>20.3</ProjectVersion>
    <FrameworkType>VCL</FrameworkType>
    <Base>True</Base>
    <Config Condition="'$(Config)'==''">Debug</Config>
    <Platform Condition="'$(Platform)'==''">Win32</Platform>
    <TargetedPlatforms>1</TargetedPlatforms>
    <AppType>Application</AppType>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Base)'!=''">
    <DCC_Namespace>
      System;Xml;Data;Datasnap;Web;Soap;Vcl;Vcl.Imaging;Vcl.Touch;Vcl.Samples;Vcl.Shell
    </DCC_Namespace>
    <DCC_DcuOutput>..\..\Output\$(DelphiVer)\runtime-lab\dcu</DCC_DcuOutput>
    <DCC_ExeOutput>..\..\Output\$(DelphiVer)\runtime-lab\bin</DCC_ExeOutput>
    <DCC_GenerateStackFrames>true</DCC_GenerateStackFrames>
    <DCC_DebugInfoInExe>true</DCC_DebugInfoInExe>
    <DCC_Optimize>false</DCC_Optimize>
  </PropertyGroup>
  <ItemGroup>
    <DelphiCompile Include="$(MainSource)">
      <MainSource>MainSource</MainSource>
    </DelphiCompile>
    <DCCReference Include="RadIA.RuntimeLab.MainForm.pas">
      <Form>RadIARuntimeLabMainForm</Form>
    </DCCReference>
    <DCCReference Include="RadIA.RuntimeLab.TargetForm.pas">
      <Form>RadIARuntimeLabTargetForm</Form>
    </DCCReference>
    <BuildConfiguration Include="Debug">
      <Key>Cfg_1</Key>
      <CfgParent>Base</CfgParent>
    </BuildConfiguration>
    <BuildConfiguration Include="Base">
      <Key>Base</Key>
    </BuildConfiguration>
  </ItemGroup>
  <Import Project="$(BDS)\Bin\CodeGear.Delphi.Targets" />
</Project>
