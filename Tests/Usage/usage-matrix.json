{
  "schemaVersion": 1,
  "profiles": [
    {
      "id": "startup",
      "description": "Loads RadIA, verifies the package contract, and closes the IDE cleanly.",
      "scenarioIds": [
        "ide-startup-shutdown"
      ]
    },
    {
      "id": "release",
      "description": "Runs IDE lifecycle and critical user-facing capability contracts.",
      "scenarioIds": [
        "ide-startup-shutdown",
        "first-conversation",
        "chat-window-state-persistence",
        "read-only-without-consent",
        "request-cancellation-recovery",
        "sensitive-data-redaction",
        "provider-cli-failure-recovery",
        "clean-install-and-upgrade",
        "agent-step-budget",
        "natural-vcl-project-creation",
        "calculator-history-fidelity",
        "build-failure-repair",
        "dunitx-create-run-repair",
        "project-session-isolation",
        "vcl-project-creation-lifecycle",
        "intent-recommendation",
        "unified-problems-panel",
        "semantic-hierarchy-refactoring",
        "advanced-breakpoints"
      ]
    }
  ],
  "targets": [
    {
      "id": "delphi12-win32",
      "delphiVersion": "23.0",
      "ide64": false,
      "required": true
    },
    {
      "id": "delphi13-win32",
      "delphiVersion": "37.0",
      "ide64": false,
      "required": true
    },
    {
      "id": "delphi13-ide64",
      "delphiVersion": "37.0",
      "ide64": true,
      "required": true
    }
  ],
  "scenarios": [
    {
      "id": "ide-startup-shutdown",
      "scope": "ide",
      "runner": "Test-RadIA.IDESmoke.ps1",
      "cycles": 1,
      "startupTimeoutSeconds": 300,
      "requiredEvidence": [
        "package-loaded",
        "tool-contract-valid",
        "clean-shutdown",
        "no-orphan-processes"
      ]
    },
    {
      "id": "agent-step-budget",
      "scope": "user-journey",
      "runner": "Test-RadIA.AgentBudgetE2E.ps1",
      "targetIds": [
        "delphi12-win32",
        "delphi13-win32",
        "delphi13-ide64"
      ],
      "observableOutcomes": [
        "plan-approved",
        "journey-completed",
        "budget-remaining",
        "no-repeated-read-only-loop"
      ],
      "requiredEvidence": [
        "planApproved",
        "journeyCompleted",
        "budgetRemaining"
      ]
    },
    {
      "id": "clean-install-and-upgrade",
      "scope": "user-journey",
      "runner": "Test-RadIA.InstallUpgradeE2E.ps1",
      "targetIds": [
        "delphi12-win32",
        "delphi13-win32",
        "delphi13-ide64"
      ],
      "observableOutcomes": [
        "package-loaded",
        "version-updated",
        "settings-preserved",
        "clean-shutdown"
      ],
      "requiredEvidence": [
        "packageLoaded",
        "versionUpdated",
        "settingsPreserved",
        "cleanShutdown"
      ]
    },
    {
      "id": "provider-cli-failure-recovery",
      "scope": "user-journey",
      "runner": "Test-RadIA.ProviderRecoveryE2E.ps1",
      "targetIds": [
        "delphi12-win32",
        "delphi13-win32",
        "delphi13-ide64"
      ],
      "observableOutcomes": [
        "actionable-error-visible",
        "session-preserved",
        "retry-succeeded",
        "raw-exception-hidden"
      ],
      "requiredEvidence": [
        "actionableErrorVisible",
        "sessionPreserved",
        "retrySucceeded"
      ]
    },
    {
      "id": "sensitive-data-redaction",
      "scope": "user-journey",
      "runner": "Test-RadIA.ConversationE2E.ps1",
      "runnerArguments": ["-SensitiveDataAudit"],
      "targetIds": [
        "delphi12-win32",
        "delphi13-win32",
        "delphi13-ide64"
      ],
      "observableOutcomes": [
        "secret-redacted",
        "prompt-content-omitted",
        "diagnostic-actionable"
      ],
      "requiredEvidence": [
        "secretRedacted",
        "promptContentOmitted",
        "diagnosticActionable"
      ]
    },
    {
      "id": "request-cancellation-recovery",
      "scope": "user-journey",
      "runner": "Test-RadIA.CancellationE2E.ps1",
      "targetIds": [
        "delphi12-win32",
        "delphi13-win32",
        "delphi13-ide64"
      ],
      "observableOutcomes": [
        "request-cancelled",
        "ui-idle",
        "next-answer-visible",
        "no-ide-restart"
      ],
      "requiredEvidence": [
        "requestCancelled",
        "uiIdle",
        "nextAnswerVisible"
      ]
    },
    {
      "id": "read-only-without-consent",
      "scope": "user-journey",
      "runner": "Test-RadIA.ProjectCreationNavigation.ps1",
      "runnerArguments": ["-ReadOnly"],
      "targetIds": [
        "delphi12-win32",
        "delphi13-win32",
        "delphi13-ide64"
      ],
      "observableOutcomes": [
        "inspection-completed",
        "navigation-completed",
        "no-consent-request",
        "clean-shutdown"
      ],
      "requiredEvidence": [
        "phases.readOnlyConsentPassed",
        "phases.shutdownPassed"
      ]
    },
    {
      "id": "chat-window-state-persistence",
      "scope": "user-journey",
      "runner": "Test-RadIA.ChatWindowPersistenceE2E.ps1",
      "targetIds": [
        "delphi12-win32",
        "delphi13-win32",
        "delphi13-ide64"
      ],
      "observableOutcomes": [
        "closed-state-restored",
        "bounds-restored",
        "dock-state-restored",
        "clean-shutdown"
      ],
      "requiredEvidence": [
        "closedStateRestored",
        "boundsRestored",
        "dockStateRestored",
        "cleanShutdown"
      ]
    },
    {
      "id": "first-conversation",
      "scope": "user-journey",
      "runner": "Test-RadIA.ConversationE2E.ps1",
      "targetIds": [
        "delphi12-win32",
        "delphi13-win32",
        "delphi13-ide64"
      ],
      "observableOutcomes": [
        "answer-visible",
        "no-agent-plan",
        "no-consent-request",
        "completed-within-20-seconds"
      ],
      "requiredEvidence": [
        "answerVisible"
      ]
    },
    {
      "id": "natural-vcl-project-creation",
      "scope": "user-journey",
      "runner": "Test-RadIA.NaturalVclChatE2E.ps1",
      "targetIds": [
        "delphi12-win32",
        "delphi13-win32",
        "delphi13-ide64"
      ],
      "observableOutcomes": [
        "project-opened",
        "build-passed",
        "application-ran",
        "clean-shutdown"
      ],
      "requiredEvidence": [
        "recommendationAccepted",
        "previewSucceeded",
        "creationSucceeded",
        "projectOpened",
        "buildPassed",
        "applicationStarted"
      ]
    },
    {
      "id": "build-failure-repair",
      "scope": "user-journey",
      "runner": "Test-RadIA.BuildRepairE2E.ps1",
      "targetIds": [
        "delphi12-win32",
        "delphi13-win32",
        "delphi13-ide64"
      ],
      "observableOutcomes": [
        "failure-reproduced",
        "source-corrected",
        "rebuild-passed",
        "clean-shutdown"
      ],
      "requiredEvidence": [
        "phases.compilerFailureObservedAndFixed",
        "phases.buildPassed",
        "phases.shutdownPassed"
      ]
    },
    {
      "id": "dunitx-create-run-repair",
      "scope": "user-journey",
      "runner": "Test-RadIA.DUnitXRepairE2E.ps1",
      "targetIds": [
        "delphi12-win32",
        "delphi13-win32",
        "delphi13-ide64"
      ],
      "observableOutcomes": [
        "test-failed",
        "test-corrected",
        "suite-passed",
        "clean-shutdown"
      ],
      "requiredEvidence": [
        "phases.testFailureObservedAndFixed",
        "phases.testsPassed",
        "phases.shutdownPassed"
      ]
    },
    {
      "id": "project-session-isolation",
      "scope": "user-journey",
      "runner": "Test-RadIA.ProjectSessionIsolationE2E.ps1",
      "targetIds": [
        "delphi12-win32",
        "delphi13-win32",
        "delphi13-ide64"
      ],
      "observableOutcomes": [
        "project-context-switched",
        "session-context-isolated",
        "pending-action-isolated",
        "clean-shutdown"
      ],
      "requiredEvidence": [
        "phases.projectContextSwitched",
        "phases.sessionContextIsolated",
        "phases.pendingActionIsolated",
        "phases.shutdownPassed"
      ]
    },
    {
      "id": "vcl-project-creation-lifecycle",
      "scope": "ide-journey",
      "runner": "Test-RadIA.ProjectCreationNavigation.ps1",
      "runnerArguments": ["-Complete"],
      "targetIds": [
        "delphi12-win32",
        "delphi13-win32",
        "delphi13-ide64"
      ],
      "observableOutcomes": [
        "project-created-and-opened",
        "calculator-built-and-started",
        "primary-calculation-observed",
        "operation-history-recorded",
        "history-clear-verified",
        "knowledge-index-ready-before-document-read",
        "clean-shutdown"
      ],
      "requiredEvidence": [
        "phases.projectCreated",
        "phases.buildPassed",
        "debugger.runtimeScenarioPassed",
        "debugger.operationHistoryPassed",
        "phases.shutdownPassed"
      ]
    },
    {
      "id": "calculator-history-fidelity",
      "scope": "user-journey",
      "runner": "Test-RadIA.NaturalVclCreationE2E.ps1",
      "targetIds": [
        "delphi12-win32",
        "delphi13-win32",
        "delphi13-ide64"
      ],
      "observableOutcomes": [
        "history-request-preserved",
        "operation-history-recorded",
        "history-clear-verified",
        "clean-shutdown"
      ],
      "requiredEvidence": [
        "phases.projectCreated",
        "phases.buildPassed",
        "debugger.runtimeScenarioPassed",
        "debugger.operationHistoryPassed",
        "phases.shutdownPassed"
      ]
    },
    {
      "id": "intent-recommendation",
      "scope": "host",
      "runner": "node-test",
      "testPath": "Tests/Web/RadIA.IntentRecommendation.test.js",
      "requiredEvidence": [
        "explicit-route-confirmation",
        "reviewable-command",
        "chat-fallback",
        "host-owned-pending-command",
        "sanitized-local-telemetry",
        "beginner-prompt-corpus"
      ]
    },
    {
      "id": "unified-problems-panel",
      "scope": "host",
      "runner": "node-test",
      "testPath": "Tests/Web/RadIA.ProblemsPanel.test.js",
      "requiredEvidence": [
        "unified-problem-contract",
        "severity-and-category-filters",
        "safe-source-navigation",
        "reviewable-recommended-action"
      ]
    },
    {
      "id": "semantic-hierarchy-refactoring",
      "scope": "host",
      "runner": "node-test",
      "testPath": "Tests/Web/RadIA.SemanticHierarchyRefactoring.test.js",
      "requiredEvidence": [
        "hierarchy-scoped-input",
        "exact-references-only",
        "preview-before-consent",
        "apply-and-rollback-regression",
        "ambiguous-overload-blocked"
      ]
    },
    {
      "id": "advanced-breakpoints",
      "scope": "host",
      "runner": "node-test",
      "testPath": "Tests/Web/RadIA.AdvancedBreakpoints.test.js",
      "requiredEvidence": [
        "delphi12-and-13-capability-matrix",
        "native-condition-and-hit-count",
        "native-logpoint",
        "reversible-configuration",
        "unsupported-exception-filter-explicit"
      ]
    }
  ]
}
