{
  "schemaVersion": 1,
  "profiles": [
    {
      "id": "startup",
      "description": "Loads RadIA, verifies the package contract, and closes the IDE cleanly.",
      "scenarioIds": [
        "ide-startup-shutdown"
      ]
    },
    {
      "id": "release",
      "description": "Runs IDE lifecycle and critical user-facing capability contracts.",
      "scenarioIds": [
        "ide-startup-shutdown",
        "intent-recommendation",
        "unified-problems-panel"
      ]
    }
  ],
  "targets": [
    {
      "id": "delphi12-win32",
      "delphiVersion": "23.0",
      "ide64": false,
      "required": true
    },
    {
      "id": "delphi13-win32",
      "delphiVersion": "37.0",
      "ide64": false,
      "required": true
    },
    {
      "id": "delphi13-ide64",
      "delphiVersion": "37.0",
      "ide64": true,
      "required": true
    }
  ],
  "scenarios": [
    {
      "id": "ide-startup-shutdown",
      "scope": "ide",
      "runner": "Test-RadIA.IDESmoke.ps1",
      "cycles": 1,
      "startupTimeoutSeconds": 180,
      "requiredEvidence": [
        "package-loaded",
        "tool-contract-valid",
        "clean-shutdown",
        "no-orphan-processes"
      ]
    },
    {
      "id": "intent-recommendation",
      "scope": "host",
      "runner": "node-test",
      "testPath": "Tests/Web/RadIA.IntentRecommendation.test.js",
      "requiredEvidence": [
        "explicit-route-confirmation",
        "reviewable-command",
        "chat-fallback",
        "host-owned-pending-command",
        "sanitized-local-telemetry",
        "beginner-prompt-corpus"
      ]
    },
    {
      "id": "unified-problems-panel",
      "scope": "host",
      "runner": "node-test",
      "testPath": "Tests/Web/RadIA.ProblemsPanel.test.js",
      "requiredEvidence": [
        "unified-problem-contract",
        "severity-and-category-filters",
        "safe-source-navigation",
        "reviewable-recommended-action"
      ]
    }
  ]
}
